# Spotify API credentials
# Get these from https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=your_client_id_here
SPOTIFY_CLIENT_SECRET=your_client_secret_here
SPOTIFY_REFRESH_TOKEN=your_refresh_token_here

# Date the refresh token above was obtained (ISO format, YYYY-MM-DD).
# Spotify refresh tokens expire 6 months after this date. Update it every
# time you re-authorize — see README.md "Re-authorizing" section.
SPOTIFY_AUTHORIZED_AT=2026-09-08

# CORS: restrict to your site origin, or leave unset to allow all origins (*)
CORS_ORIGIN=https://your-site.com

# Port for Node.js / Docker deployments (default: 3000)
PORT=3000
